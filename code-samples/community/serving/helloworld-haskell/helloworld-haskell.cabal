cabal-version: 3.0
name: helloworld-haskell
version: 0.1.0.0
synopsis: A minimal Knative Serving greeting service
description: A small HTTP service demonstrating Knative environment configuration.
category: Web
maintainer: Knative community
license: Apache-2.0
license-file: LICENSE
build-type: Simple

executable helloworld-haskell-exe
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N1
  build-depends:
    base >= 4.20 && < 4.21,
    scotty == 0.30,
    text >= 2.1 && < 2.2
